{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "plyntiq",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One Worker serves the SPA and the API from the same origin: no CORS, and
  // auth cookies stay first-party with SameSite=Lax.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plyntiq",
      // Replace with the ID printed by `wrangler d1 create plyntiq` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly: deletes CSV import previews older than 24 hours (privacy.md).
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:5173",
    "BETTER_AUTH_URL": "http://localhost:5173"
  }
  // Secrets (never committed): BETTER_AUTH_SECRET — set via `.dev.vars` locally
  // and `wrangler secret put BETTER_AUTH_SECRET` in production.
}
