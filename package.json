{
  "name": "plyntiq",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @plyntiq/api & npm run dev --workspace @plyntiq/web",
    "build": "npm run build --workspace @plyntiq/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @plyntiq/api",
    "db:migrate:local": "npm run db:migrate:local --workspace @plyntiq/api"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true,
    "fsevents@2.3.3": true
  }
}
